#!/usr/bin/env python3
"""Build the LaTeX CV, or verify a built PDF against its source files."""

import argparse
import hashlib
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PDF_DIR = ROOT / "assets" / "pdf"
PDF = PDF_DIR / "CV.pdf"
SOURCES = {
    "CVSourceMDfive": PDF_DIR / "CV.tex",
    "CVBibliographyMDfive": ROOT / "_bibliography" / "papers.bib",
}


def check(pdf):
    data = pdf.read_bytes()
    for field, source in SOURCES.items():
        digest = hashlib.md5(source.read_bytes()).hexdigest().upper()
        if not re.search(rb"/" + field.encode() + rb"\s*\(" + digest.encode() + rb"\)", data):
            raise ValueError(f"CV.pdf does not match {source.relative_to(ROOT)}. Run bin/build-cv.")


def build():
    # Building beside the final PDF lets replace() install it atomically.
    with tempfile.TemporaryDirectory(prefix=".cv-build-", dir=PDF_DIR) as directory:
        work = Path(directory)
        for source in SOURCES.values():
            shutil.copyfile(source, work / source.name)
        subprocess.run(
            ["latexmk", "-pdf", "-halt-on-error", "-interaction=nonstopmode", "CV.tex"],
            cwd=work, check=True,
        )
        result = work / "CV.pdf"
        check(result)
        result.replace(PDF)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="check source freshness without running LaTeX")
    args = parser.parse_args()
    try:
        if args.check:
            check(PDF)
            print("CV.pdf matches CV.tex and the Publications bibliography.")
        else:
            build()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        sys.exit(str(error))
