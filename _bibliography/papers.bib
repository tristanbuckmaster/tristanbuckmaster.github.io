@book{buckmaster2021nonconservative,
  abbr = {Ann. Math. Stud.},
  bibtex_show = {true},
  arxiv = {2101.09278},
  abstract = {For any positive regularity parameter $\beta<{\frac{1}{2}}$, we construct non-conservative weak solutions of the 3D incompressible Euler equations which lie in $H^\beta$  uniformly in time. In particular, we construct solutions which have an $L^2$-based regularity index strictly larger than $\frac{1}{3}$, thus deviating from the $H^{\frac{1}{3}}$-regularity corresponding to the Kolmogorov-Obhukov $\frac{5}{3}$ power spectrum in the inertial range.},
  author = {Buckmaster, T. and Masmoudi, N. and Novack, M. and Vicol, V.},
  series = {Annals of Mathematics Studies},
  volume = {217},
  publisher = {Princeton University Press},
  isbn = {9780691249544},
