}

@article{BDLSV17,
  abbr = {Comm. Pure Appl. Math},
  bibtex_show = {true},
  arxiv = {1701.08678},
  html = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cpa.21781},
  abstract = {We prove that given any $\beta<1/3$, a time interval $[0,T]$, and given any smooth energy profile $e : [0,T] \to (0,\infty)$, there exists a weak solution $v$ of the three-dimensional Euler equations such that $v \in C^{\beta}([0,T]\times \mathbb{T}^3)$, with $e(t) = \int_{\mathbb{T}^3} |v(x,t)|^2 dx$ for all $t\in [0,T]$. Moreover, we show that a suitable $h$-principle holds in the regularity class $C^\beta_{t,x}$, for any $\beta<1/3$. The implication of this is that the dissipative solutions we construct are in a sense typical in the appropriate space of subsolutions as opposed to just isolated examples.},
  author = {Buckmaster, T. and {De Lellis}, C. and {Sz{\'e}kelyhidi Jr.}, L. and Vicol, V.},
  date-added = {2021-07-13 22:13:09 -0400},
  date-modified = {2021-07-13 22:13:15 -0400},
  doi = {https://doi.org/10.1002/cpa.21781},
  journal = {Communications on Pure and Applied Mathematics},
